@page "/clientes/{ClienteId:int}/historial"
@inject Zetta.Client.Servicios.IClienteService ClienteService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="clientes-container">
    <header class="clientes-header text-center mb-4">
        <h1>Historial Técnico</h1>
        <p class="subtitle">Línea de tiempo cronológica de presupuestos, obras y visitas</p>
    </header>

    @if (Cargando)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-warning" role="status"></div>
            <p class="mt-3">Cargando historial...</p>
        </div>
    }
    else if (Historial == null || !Historial.Any())
    {
        <div class="timeline-empty">Sin actividad registrada.</div>
    }
    else
    {
        <div class="timeline">
            @foreach (var item in Historial)
            {
                <div class="timeline-item card">
                    <div class="card-body">
                        <div class="timeline-icon">
                            <i class="@GetIconClass(item.Tipo)"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <small class="text-muted">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                                    <strong class="d-block mt-1">@item.Titulo</strong>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-dark">@item.Tipo</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Estado))
                                    {
                                        <span class="badge bg-warning text-dark ms-1">@item.Estado</span>
                                    }
                                </div>
                            </div>

                            <p class="mb-1 mt-2">@item.Descripcion</p>

                            @if (item.ReferenciaId.HasValue)
                            {
                                <div class="mt-2">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirReferencia(item)">
                                        Ver
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int ClienteId { get; set; }
    private List<Zetta.Shared.DTOS.Historial.HistorialTecnicoDTO>? Historial;
    private bool Cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Historial = await ClienteService.GetHistorialAsync(ClienteId) ?? new();
        }
        catch
        {
            Historial = new List<Zetta.Shared.DTOS.Historial.HistorialTecnicoDTO>();
        }
        finally
        {
            Cargando = false;
        }
    }

    private string GetIconClass(string tipo) => tipo switch
    {
        "Presupuesto" => "bi bi-file-earmark-text-fill",
        "Obra" => "bi bi-building",
        "Visita" => "bi bi-wrench-adjustable-circle-fill",
        "Comentario" => "bi bi-chat-dots-fill",
        _ => "bi bi-circle-fill"
    };

    private void AbrirReferencia(Zetta.Shared.DTOS.Historial.HistorialTecnicoDTO item)
    {
        if (!item.ReferenciaId.HasValue) return;
        var id = item.ReferenciaId.Value;
        if (item.Tipo == "Presupuesto")
            Navigation.NavigateTo($"/presupuestos/editar/{id}");
        else if (item.Tipo == "Obra")
            Navigation.NavigateTo($"/obras/{id}");
        else if (item.Tipo == "Visita")
            Navigation.NavigateTo($"/visitas"); // ajustar ruta si hay detalle de visita
    }
}
